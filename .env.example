# App URL & Server
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Database (PostgreSQL / Prisma reference configuration)
DATABASE_URL="postgresql://pgfinder:password@localhost:5432/pgfinder_db?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="replace-with-32-char-secure-random-secret"
JWT_REFRESH_SECRET="replace-with-32-char-secure-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Provider Abstraction (Razorpay / Stripe / Configurable)
PAYMENT_PROVIDER="demo_gateway"
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-secret"

# Mobile / AdMob (Test IDs only in development)
VITE_ADMOB_ENV="test"
VITE_ADMOB_ANDROID_BANNER_ID="ca-app-pub-3940256099942544/6300978111"
VITE_ADMOB_IOS_BANNER_ID="ca-app-pub-3940256099942544/2934735716"
